# Copie para .env e ajuste. (O servidor lê as variáveis do ambiente;
# para carregar o arquivo use: node --env-file=.env server/index.js)
PORT=3000
DB_PATH=./data/peludinho.db
# Token do painel do salão (obrigatório em produção). Gere um valor longo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=troque-este-token-em-producao
# Número do WhatsApp do salão (DDI+DDD+número, só dígitos)
WHATSAPP_NUMBER=5511994375673
# Quantos pets podem ser atendidos ao mesmo tempo
CAPACIDADE=1
